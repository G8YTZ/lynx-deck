[Unit]
Description=Lynx Deck - networked media player
After=network-online.target
Wants=network-online.target

[Service]
User=lynx
Group=lynx
SupplementaryGroups=video render audio input
WorkingDirectory=/home/lynx/lynx-deck
ExecStart=/usr/bin/python3 -m lynxdeck --config /home/lynx/lynx-deck/config/lynx_deck.yaml
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
