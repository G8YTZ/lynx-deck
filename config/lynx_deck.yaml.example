# Lynx Deck configuration
media_dir: /srv/lynxdeck/media

# Output - match your ATEM's video standard
video_format: 1080p25         # what controllers are told
drm_connector: HDMI-A-1       # HDMI0 = the micro-HDMI port nearest the USB-C power
# The HDMI mode is set by the kernel at boot, not by the deck. Add to
# /boot/firmware/cmdline.txt (one line):
#   video=HDMI-A-1:1920x1080@25e
drm_mode: 1920x1080@25
timecode_fps: 25

# Stills hold forever in single-clip mode; when playing through the list
# they advance after this many seconds
still_duration: 10

# Player: mpv, hardware decode straight to a DRM overlay plane (zero copy).
# hwdec must be "drm" with vo=gpu; "drm-copy" works but costs ~190% CPU,
# and "auto" falls back to software (about 4 fps on 1080p HEVC).
hwdec: drm
drm_draw_plane: primary
drm_video_plane: overlay
mpv_socket: /tmp/lynxdeck-mpv.sock
poll_interval: 0.5

# Deck identity
hyperdeck_port: 9993
model: Lynx Deck
protocol_version: "1.11"
unique_id: LYNXDECK0001
volume_name: LynxDeck

# Watchdog
player_timeout: 5         # max wait for any player reply
watchdog_interval: 2      # how often to check the player is alive
stall_timeout: 5          # playing but timecode frozen this long = stalled
report_health: true       # add "player: ok|stalled|restarting" to transport info

# Web UI / REST API
http_port: 8080
api_token: ""             # set a token to require X-Lynx-Token on reboot/rescan
max_upload_mb: 8192       # largest file the upload endpoint will accept

# The deck's default slide (name or number). It is played at boot, returned to
# when the running order finishes, and fallen back to if a clip goes missing.
# Leave blank to cue clip 1 and stop instead.
default_clip: ""

# What an unmarked clip does when it ends: auto | once | loop | hold.
# Use "hold" when Companion triggers drive the running order, so nothing
# advances on its own.
default_behaviour: auto

# Audio output. The Pi's ALSA default is the 3.5mm jack, so HDMI must be named.
# HDMI0 (the port nearest USB-C) is vc4hdmi0; the other port is vc4hdmi1.
audio_device: "alsa/sysdefault:CARD=vc4hdmi0"
volume: 100
load_timeout: 5           # max wait for a clip to load before play is allowed
